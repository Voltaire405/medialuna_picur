# Base de datos: vacío o comentado usa file:local.db (libsql local). Para Turso, descomente:
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# Better Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Correo de recuperación (Resend). Sin RESEND_API_KEY el correo se imprime en consola.
RESEND_API_KEY=
MAIL_FROM=Medialuna <onboarding@resend.dev>
# TRUE (por defecto): acepta correos desechables (yopmail, etc.) para pruebas. FALSE en producción: los rechaza.
DEVELOPMENT_STAGE=TRUE
# Seed del administrador
SEED_ADMIN_ID=1000000001
SEED_ADMIN_EMAIL=admin@medialuna.local
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Admin12345
